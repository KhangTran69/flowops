# FlowOps configuration (optional).
# The app works without a .env file; these document available options.
# Copy to .env and adjust if needed — set values in your shell instead
# of installing a dotenv dependency.

# Sample data source (simulated tickets from JSONPlaceholder)
FLOWOPS_SAMPLE_API_URL=https://jsonplaceholder.typicode.com/todos/1

# Directory where the intake API stores normalized tickets (v0.2, superseded by the database in v0.3)
FLOWOPS_TICKET_STORE_DIR=data/tickets

# Database URL (SQLite default; use postgresql+psycopg://... for PostgreSQL)
FLOWOPS_DATABASE_URL=sqlite:///data/flowops.db

# Optional authenticated action execution.
FLOWOPS_ENVIRONMENT=development
FLOWOPS_AUTH_REQUIRED=false

# Operator console session auth (off for local development).
FLOWOPS_UI_AUTH_REQUIRED=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOWOPS_SESSION_SECRET=
FLOWOPS_SESSION_MAX_AGE_SECONDS=3600
FLOWOPS_SESSION_COOKIE_SECURE=false
# Optional local UI users. Passwords must be PBKDF2 hashes generated with:
# python -m src.demo_users hash
FLOWOPS_DEMO_USERS={}
FLOWOPS_DEV_BEARER_TOKEN=
FLOWOPS_ENTRA_ISSUER=
FLOWOPS_ENTRA_AUDIENCE=
FLOWOPS_ENTRA_JWKS_URL=
FLOWOPS_ENTRA_REQUIRED_ROLE=automation.operator
FLOWOPS_ACTION_ADAPTER=simulated
FLOWOPS_AUTOMATION_ADAPTER=simulated
# n8n integration (set adapter=n8n only after importing/configuring workflows)
FLOWOPS_N8N_WEBHOOK_URL=
FLOWOPS_N8N_WEBHOOK_SECRET=
FLOWOPS_N8N_API_KEY=
FLOWOPS_AUTOMATION_CALLBACK_SECRET=
FLOWOPS_WORKFORCE_POLL_INTERVAL=2
FLOWOPS_POWER_AUTOMATE_URL=
# rpa = UiPath/Automation Anywhere/Blue Prism-style webhook adapter
FLOWOPS_RPA_WEBHOOK_URL=
FLOWOPS_RPA_BOT=default
FLOWOPS_RPA_SECRET=
FLOWOPS_RPA_TIMEOUT=10
# graph = real Microsoft Graph (OAuth2 client credentials, per tenant)
# graph_simulated = same code path against an in-memory Graph (no credentials)
FLOWOPS_GRAPH_URL=https://graph.microsoft.com/v1.0
FLOWOPS_GRAPH_CLIENT_ID=
FLOWOPS_GRAPH_CLIENT_SECRET=
# Single-tenant defaults (multi-tenant deployments use PUT /tenants/{key})
FLOWOPS_GRAPH_TENANT_ID=
FLOWOPS_GRAPH_DEFAULT_DOMAIN=
FLOWOPS_GRAPH_DEFAULT_SKU=O365_BUSINESS_PREMIUM
FLOWOPS_GRAPH_USAGE_LOCATION=
# Optional pre-issued token instead of client credentials (default tenant only)
FLOWOPS_GRAPH_ACCESS_TOKEN=
# Per-tenant app override: FLOWOPS_TENANT_<CREDENTIAL_REF>_GRAPH_CLIENT_ID / _SECRET

# Exchange Online PowerShell (shared-mailbox conversion Graph can't do)
FLOWOPS_POWERSHELL_PATH=pwsh
FLOWOPS_POWERSHELL_DRY_RUN=true
FLOWOPS_EXO_APP_ID=
FLOWOPS_EXO_CERT_THUMBPRINT=
FLOWOPS_EXO_ORGANIZATION=

# ConnectWise Manage (POST /tickets/{id}/psa-sync)
FLOWOPS_CW_SITE=
FLOWOPS_CW_COMPANY_ID=
FLOWOPS_CW_PUBLIC_KEY=
FLOWOPS_CW_PRIVATE_KEY=
FLOWOPS_CW_CLIENT_ID=
FLOWOPS_ACTION_RETRIES={}
FLOWOPS_ACTION_FAILURE_WEBHOOK_URL=

# Optional API key required by POST /webhooks/intake
FLOWOPS_WEBHOOK_API_KEY=

# Required for signed ChatOps approve/reject links (24h, single-use)
FLOWOPS_CHATOPS_SECRET=

# The container entrypoint runs Alembic migrations unless disabled
FLOWOPS_RUN_MIGRATIONS=true

# Optional in-process rate limit for mutating requests per minute (0 = off)
FLOWOPS_RATE_LIMIT_PER_MINUTE=0

# Optional AI adapter (default simulated; LLM requires an injected client)
# simulated | claude | openai | gemini | groq | openrouter | ollama
FLOWOPS_AI_ADAPTER=simulated
FLOWOPS_AI_API_KEY=
# Used when FLOWOPS_AI_ADAPTER=claude and FLOWOPS_AI_API_KEY is empty
ANTHROPIC_API_KEY=

# MCP server (python -m src.mcp_server)
FLOWOPS_API_URL=http://127.0.0.1:8000
FLOWOPS_MCP_API_TOKEN=
FLOWOPS_MCP_ALLOW_WRITES=false
# Optional OpenAI-compatible provider override (Gemini/Groq/OpenRouter/Ollama)
FLOWOPS_AI_BASE_URL=
FLOWOPS_AI_MODEL=
FLOWOPS_AI_TIMEOUT=30

FLOWOPS_GATEWAY_PORT=80
FLOWOPS_WEBHOOK_SINK_PORT=8081
FLOWOPS_GRAFANA_PORT=3000
FLOWOPS_GRAFANA_ADMIN_USER=admin
FLOWOPS_GRAFANA_ADMIN_PASSWORD=flowops-admin

FLOWOPS_NOTIFICATION_MAX_ATTEMPTS=5

# Workflow DAG orchestrator
FLOWOPS_DAG_MAX_PARALLEL=4
FLOWOPS_DAG_LEASE_SECONDS=60
FLOWOPS_DAG_SCHEDULER_INTERVAL=2

# SLA timer service
FLOWOPS_TIMER_INTERVAL=2
FLOWOPS_ESCALATION_WEBHOOK_URL=


# Microsoft Graph client-credentials integration
FLOWOPS_GRAPH_TENANT_ID=
FLOWOPS_GRAPH_CLIENT_ID=
FLOWOPS_GRAPH_CLIENT_SECRET=
FLOWOPS_GRAPH_SKU_ID=

# Mock ConnectWise Manage adapter
FLOWOPS_CONNECTWISE_URL=https://api.connectwise.com
