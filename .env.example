# FlowOps configuration (optional).
# The app works without a .env file; these document available options.
# Copy to .env and adjust if needed — set values in your shell instead
# of installing a dotenv dependency.

# Sample data source (simulated tickets from JSONPlaceholder)
FLOWOPS_SAMPLE_API_URL=https://jsonplaceholder.typicode.com/todos/1

# Directory where the intake API stores normalized tickets (v0.2, superseded by the database in v0.3)
FLOWOPS_TICKET_STORE_DIR=data/tickets

# Database URL (SQLite default; use postgresql+psycopg://... for PostgreSQL)
FLOWOPS_DATABASE_URL=sqlite:///data/flowops.db

# Optional authenticated action execution.
FLOWOPS_ENVIRONMENT=development
FLOWOPS_AUTH_REQUIRED=false
FLOWOPS_DEV_BEARER_TOKEN=
FLOWOPS_ENTRA_ISSUER=
FLOWOPS_ENTRA_AUDIENCE=
FLOWOPS_ENTRA_JWKS_URL=
FLOWOPS_ENTRA_REQUIRED_ROLE=automation.operator
FLOWOPS_ACTION_ADAPTER=simulated
FLOWOPS_POWER_AUTOMATE_URL=
FLOWOPS_GRAPH_URL=https://graph.microsoft.com/v1.0
FLOWOPS_GRAPH_ACCESS_TOKEN=
FLOWOPS_ACTION_RETRIES={}
FLOWOPS_ACTION_FAILURE_WEBHOOK_URL=

# Optional API key required by POST /webhooks/intake
FLOWOPS_WEBHOOK_API_KEY=

# The container entrypoint runs Alembic migrations unless disabled
FLOWOPS_RUN_MIGRATIONS=true

# Optional in-process rate limit for mutating requests per minute (0 = off)
FLOWOPS_RATE_LIMIT_PER_MINUTE=0

# Optional AI adapter (default simulated; LLM requires an injected client)
FLOWOPS_AI_ADAPTER=simulated
FLOWOPS_AI_API_KEY=
# Optional OpenAI-compatible provider override (Gemini/Groq/OpenRouter/Ollama)
FLOWOPS_AI_BASE_URL=
FLOWOPS_AI_MODEL=
FLOWOPS_AI_TIMEOUT=30

# Total delivery attempts before an outbox row becomes dead-letter (failed)
FLOWOPS_NOTIFICATION_MAX_ATTEMPTS=5
