# Copy this file to .connector-secrets.env and set only the connector secrets
# used by this checkout. The copied file is ignored by Git and is passed only
# to the app (poll-now/webhook verification) and scheduler (scheduled polling).

# Tenant-scoped connector secrets (tenant key uppercased; dashes become _)
FLOWOPS_TENANT_ACME_CONNECTOR_JIRA_API_TOKEN=
FLOWOPS_TENANT_ACME_CONNECTOR_SERVICENOW_USERNAME=
FLOWOPS_TENANT_ACME_CONNECTOR_SERVICENOW_PASSWORD=
FLOWOPS_TENANT_ACME_CONNECTOR_SLACK_SIGNING_SECRET=

# Optional secrets for connectors intentionally configured without a tenant
FLOWOPS_CONNECTOR_JIRA_API_TOKEN=
FLOWOPS_CONNECTOR_SERVICENOW_USERNAME=
FLOWOPS_CONNECTOR_SERVICENOW_PASSWORD=
FLOWOPS_CONNECTOR_SLACK_SIGNING_SECRET=
