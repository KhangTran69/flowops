# Copy to .tenant-webhook-secrets.env and set values for each tenant.
# <REF> is the tenant's server-managed credential_ref.
FLOWOPS_TENANT_ACME_WEBHOOK_API_KEY=
# Exact hostnames only; comma-separated. No schemes, ports, paths, or wildcards.
FLOWOPS_TENANT_ACME_NOTIFY_ALLOWED_HOSTS=hooks.example.com,events.partner.example
