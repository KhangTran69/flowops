{
  "name": "FlowOps - Shared mailbox to ticket intake",
  "nodes": [
    {
      "parameters": {"pollTimes": {"item": [{"mode": "everyMinute"}]}, "filters": {"foldersToInclude": ["inbox"]}, "options": {}},
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "New support email (Outlook)",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": {"microsoftOutlookOAuth2Api": {"id": "REPLACE_ME", "name": "Support mailbox"}}
    },
    {
      "parameters": {
        "jsCode": "// Reshape Outlook messages into the FlowOps intake schema.\n// Handles missing subjects and maps the sender domain to a tenant key.\nconst domainToTenant = { 'acme.com': 'acme', 'globex.com': 'globex' };\nreturn $input.all().map((item, index) => {\n  const msg = item.json;\n  const from = (msg.from?.emailAddress?.address || '').toLowerCase();\n  const domain = from.split('@')[1] || '';\n  const subject = (msg.subject || '').trim() || '(no subject)';\n  // Stable numeric id from the Graph message id so re-runs update, not duplicate.\n  let hash = 0;\n  for (const ch of String(msg.id || index)) hash = (hash * 31 + ch.charCodeAt(0)) % 2147483647;\n  return { json: { userId: 1, id: hash || 1, title: subject.slice(0, 500), completed: false, tenant: domainToTenant[domain] || null } };\n});"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "Map to FlowOps schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLOWOPS_URL }}/webhooks/intake",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($input.all().map(i => i.json)) }}",
        "options": {"batching": {"batch": {"batchSize": 1}}, "response": {"response": {"neverError": false}},
                    "retry": {"maxTries": 3, "waitBetweenTries": 2000}}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "POST /webhooks/intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 3,
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_ME", "name": "FlowOps X-API-Key"}}
    },
    {
      "parameters": {
        "conditions": {"options": {"caseSensitive": true}, "combinator": "and",
          "conditions": [{"leftValue": "={{ $json.priority }}", "rightValue": "critical", "operator": {"type": "string", "operation": "equals"}}]}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Critical?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TEAMS_INCOMING_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `Critical ticket ${$json.ticket_id}: ${$json.title} -> ${$json.queue}` }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Alert Teams channel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, -100]
    }
  ],
  "connections": {
    "New support email (Outlook)": {"main": [[{"node": "Map to FlowOps schema", "type": "main", "index": 0}]]},
    "Map to FlowOps schema": {"main": [[{"node": "POST /webhooks/intake", "type": "main", "index": 0}]]},
    "POST /webhooks/intake": {"main": [[{"node": "Critical?", "type": "main", "index": 0}]]},
    "Critical?": {"main": [[{"node": "Alert Teams channel", "type": "main", "index": 0}], []]}
  },
  "settings": {"executionOrder": "v1", "errorWorkflow": "REPLACE_WITH_03_ERROR_WORKFLOW_ID"},
  "pinData": {},
  "meta": {"templateCredsSetupCompleted": false}
}
