{
  "name": "FlowOps - Nightly tenant drift + failed job alerts",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "cronExpression", "expression": "0 6 * * 1-5"}]}},
      "id": "c1b2c3d4-0003-4000-8000-000000000001",
      "name": "Weekdays 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "id": "c1b2c3d4-0003-4000-8000-000000000002",
      "name": "Error Trigger (other workflows)",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FLOWOPS_URL }}/tenants/drift-check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {"timeout": 120000}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000003",
      "name": "Run cross-tenant drift check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_ME", "name": "FlowOps bearer token"}}
    },
    {
      "parameters": {
        "url": "={{ $env.FLOWOPS_URL }}/workflow-jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {"parameters": [{"name": "status", "value": "failed"}, {"name": "limit", "value": "50"}]},
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000004",
      "name": "Get failed (dead-letter) jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_ME", "name": "FlowOps bearer token"}}
    },
    {
      "parameters": {
        "jsCode": "// Build one plain-English digest; skip sending when everything is green.\nconst drift = $('Run cross-tenant drift check').first().json;\nconst failed = $input.all().map(i => i.json).flat();\nconst lines = [];\nfor (const t of drift.results || []) {\n  if (t.status === 'compliant') continue;\n  const issues = t.status === 'error' ? [t.error] : t.findings.filter(f => f.status === 'drift').map(f => `${f.check} expected ${f.expected}, got ${f.actual}`);\n  lines.push(`- ${t.name} (${t.tenant}): ${issues.join('; ')}`);\n}\nfor (const j of failed) lines.push(`- Failed job #${j.id} ${j.label || j.job_type}: ${(j.last_error || '').slice(0, 160)}`);\nif (!lines.length) return [];\nreturn [{ json: { text: `FlowOps morning check - ${lines.length} item(s) need attention:\\n${lines.join('\\n')}\\nRunbook: docs/runbooks/` } }];"
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000005",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { text: `n8n workflow '${e.workflow?.name}' failed at node '${e.execution?.lastNodeExecuted}': ${e.execution?.error?.message}. Execution: ${e.execution?.url}` } }];"
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000006",
      "name": "Format workflow error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TEAMS_INCOMING_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000007",
      "name": "Post to Teams",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 150]
    }
  ],
  "connections": {
    "Weekdays 06:00": {"main": [[{"node": "Run cross-tenant drift check", "type": "main", "index": 0}]]},
    "Run cross-tenant drift check": {"main": [[{"node": "Get failed (dead-letter) jobs", "type": "main", "index": 0}]]},
    "Get failed (dead-letter) jobs": {"main": [[{"node": "Build digest", "type": "main", "index": 0}]]},
    "Build digest": {"main": [[{"node": "Post to Teams", "type": "main", "index": 0}]]},
    "Error Trigger (other workflows)": {"main": [[{"node": "Format workflow error", "type": "main", "index": 0}]]},
    "Format workflow error": {"main": [[{"node": "Post to Teams", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "pinData": {},
  "meta": {"templateCredsSetupCompleted": false}
}
